{
  "manifest_version": 3,
  "name": "Moonfill",
  "version": "2.1",
  "description": "Moonfill automates and speeds up the completion of the Moonpull form. Just enter your MID and region, and Moonfill takes care of the rest effortlessly.",
  "permissions": ["tabs", "storage", "activeTab", "scripting", "webRequest", "alarms", "notifications", "tabGroups"],
  "host_permissions": [
    "https://forms.office.com/*",
    "https://forms.cloud.microsoft/*",
    "https://awin.lightning.force.com/*",
    "https://zanox.sharepoint.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://forms.office.com/*", "https://forms.cloud.microsoft/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://awin.lightning.force.com/*"],
      "js": ["salesforce.js"]
    },
    {
      "matches": ["https://awin.lightning.force.com/*", "file:///*/autofill/dev/mock/*.html*"],
      "js": ["autofill/fields.js", "autofill/config.js", "autofill/settings.js", "autofill/engine.js", "autofill/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "autofill/options.html", "open_in_tab": true },
  "web_accessible_resources": [
    { "resources": ["autofill/options.html"], "matches": ["https://awin.lightning.force.com/*"] }
  ]
}
